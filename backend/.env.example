# Copy this file to `.env` and replace placeholders with your local values.

# Application
PORT=3000
NODE_ENV=development

# PostgreSQL connection string (requires PostgreSQL >= 15)
DATABASE_URL="postgresql://user:password@localhost:5432/sify_workforce"

# UMS / Keycloak integration (production only — ignored in dev/test mode)
# Confirmed UMS dev environment: https://apidev.sifymodernization.digital/user-mgt/api
# Confirmed app ID: Project-Management
# Keycloak issuer: http://1.6.37.35/keycloak/realms/Project-Management
UMS_BASE_URL=https://apidev.sifymodernization.digital/user-mgt/api
UMS_APP_ID=Project-Management

# Mail Configuration (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Sify Workforce" <noreply@sifyworkforce.com>

# Frontend URL (for invitation links)
FRONTEND_URL=http://localhost:5173
