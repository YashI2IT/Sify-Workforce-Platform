// use prisma-next
model Organization {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())

  employees Employee[]
  teams     Team[]
  projects  Project[]

  @@map("organization")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  managerId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  organization   Organization @relation(fields:[organizationId], references:[id])
  manager        Employee?    @relation("TeamManager", fields:[managerId], references:[id])
  employees      Employee[]   @relation("TeamMembers")

  @@unique([organizationId, name])
  @@map("team")
}

model Employee {
  id             String       @id @default(uuid())
  organizationId String
  teamId         String?
  employeeCode   String
  name           String
  email          String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  organization   Organization @relation(fields:[organizationId], references:[id])
  team           Team?        @relation("TeamMembers", fields:[teamId], references:[id])
  managedTeams   Team[]       @relation("TeamManager")
  projectAssignments EmployeeProject[]
  timeEntries    TimeEntry[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, email])
  @@map("employee")
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  status         String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  organization   Organization @relation(fields:[organizationId], references:[id])
  tasks          Task[]
  activities     Activity[]
  employeeAssignments EmployeeProject[]
  timeEntries    TimeEntry[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@map("project")
}

model Task {
  id             String       @id @default(uuid())
  projectId      String
  name           String
  description    String?
  status         String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  project        Project      @relation(fields:[projectId], references:[id])
  timeEntries    TimeEntry[]

  @@unique([projectId, name])
  @@map("task")
}

model Activity {
  id             String       @id @default(uuid())
  projectId      String
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())

  project        Project      @relation(fields:[projectId], references:[id])
  timeEntries    TimeEntry[]

  @@unique([projectId, name])
  @@map("activity")
}

model EmployeeProject {
  employeeId String
  projectId  String

  employee   Employee @relation(fields:[employeeId], references:[id])
  project    Project  @relation(fields:[projectId], references:[id])

  @@unique([employeeId, projectId])
  @@map("employee_project")
}

model TimeEntry {
  id         String   @id @default(uuid())
  employeeId String
  projectId  String
  taskId     String
  activityId String
  date       String
  hours      Float
  remarks    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  employee   Employee @relation(fields:[employeeId], references:[id])
  project    Project  @relation(fields:[projectId], references:[id])
  task       Task     @relation(fields:[taskId], references:[id])
  activity   Activity @relation(fields:[activityId], references:[id])

  @@map("time_entry")
}
