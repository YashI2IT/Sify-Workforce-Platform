{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node -e \"import fs from 'fs'; fs.rmSync('./dist', { recursive: true, force: true });\" && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "nodemailer": "^10.0.10",
    "prisma": "8.0.0-rc.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typescript": "^6.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
